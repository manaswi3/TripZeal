<style>
  .tz-footer-wrap {
  position: relative;
  margin-top: 3rem;
  font-family: 'Poppins', sans-serif;
  overflow: hidden;
}

.tz-footer {
  background-image: url('/assets/footer.png');
  background-size: cover;
  background-position: center bottom;  /* ← shows dunes, hides cream top */
  height: 350px;
  
  position: relative;
  overflow: hidden;

display: flex;
  align-items: flex-end;    /* push content to bottom */
  justify-content: center;
  padding-bottom: 3.5rem;
}

.tz-footer-inner {
  position: relative;
  z-index: 2;
  max-width: 960px;
  text-align: center;
  justify-content: center;
}
  /* ── Footer content ── */

  /* Brand */
  .footer-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    text-decoration: none;
  }
  .footer-brand-name {
    font-weight: 700;
    font-size: 1.2rem;
    color: #1a1a1a;
  }

  /* Tagline */
  .footer-tagline {
    font-family: 'Caveat', cursive;
    font-size: 1.2rem;
    color: #1a1a1a;
    opacity: 0.75;
    margin-bottom: 1.6rem;
  }

  /* Nav links row */
  .footer-links-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.2rem 1.6rem;
    margin-bottom: 0.75rem;
  }
  .footer-links-row a {
    font-size: 0.82rem;
    font-weight: 500;
    color: #1a1a1a;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.15s;
  }
  .footer-links-row a:hover { opacity: 1; text-decoration: underline; }

  /* Divider */
  .footer-divider {
    width: 60px;
    height: 2px;
    background: rgba(0,0,0,0.15);
    margin: 0 auto 1.3rem;
    border-radius: 2px;
  }

  /* Socials */
  .footer-socials {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
  }
  .footer-socials a {
    width: 38px;
    height: 38px;
    background: #1a1a1a;
    color: #FFB800;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    text-decoration: none;
    transition: transform 0.2s, background 0.2s;
  }
  .footer-socials a:hover {
    transform: translateY(-3px);
    background: #333;
  }

  /* Copyright */
  .footer-copy {
    font-size: 0.78rem;
    color: #1a1a1a;
    opacity: 0.65;
    margin-bottom: 0.3rem;
  }
  .footer-copy a {
    color: #1a1a1a;
    opacity: 0.8;
    text-decoration: none;
    margin: 0 0.5rem;
  }
  .footer-copy a:hover { text-decoration: underline; }

  @media (max-width: 480px) {
    .tz-footer { border-radius: 40% 40% 0 0 / 20px 20px 0 0; }
    .footer-links-row { gap: 0.4rem 1rem; }
  }
</style>


<!-- ── Footer ── -->
<footer class="tz-footer-wrap">
  <div class="tz-footer">
    <div class="tz-footer-inner">

      <!-- Brand -->
      <a href="/listings" class="footer-brand">
        <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
          <circle cx="20" cy="20" r="18" fill="rgba(255,255,255,0.25)" stroke="#1a1a1a" stroke-width="2"/>
          <circle cx="20" cy="20" r="14" stroke="#1a1a1a" stroke-width="1.5" fill="none" stroke-dasharray="3 2"/>
          <polygon points="20,8 22.5,20 20,18 17.5,20" fill="#1a1a1a"/>
          <polygon points="20,32 22.5,20 20,22 17.5,20" fill="rgba(0,0,0,0.4)"/>
          <circle cx="20" cy="20" r="2.2" fill="#1a1a1a"/>
        </svg>
        <span class="footer-brand-name">TripZeal</span>
      </a>

      <p class="footer-tagline">Your next adventure is just a click away ✈️</p>

      <!-- Quick links -->
      <div class="footer-links-row">
        <a href="/listings">Explore</a>
        <a href="/listings/new">Add Listing</a>
        <a href="/about">About Us</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/contact">Contact</a>
      </div>

      <div class="footer-divider"></div>

      <!-- Socials -->
      <div class="footer-socials">
        <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
        <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
        <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
        <a href="#" aria-label="Twitter / X"><i class="fa-brands fa-x-twitter"></i></a>
      </div>

      <!-- Copyright -->
      <p class="footer-copy">
        &copy; <%= new Date().getFullYear() %> TripZeal Private Limited. All rights reserved.
      </p>

    </div>
  </div>
</footer>
