<% layout("/layouts/boilerplate") -%>
<body>
    <h3>All listings</h3>
    <!-- <form method="GET" action="/listing/new">
        <button>Add new Listing</button>
    </form> -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <%for(let info of allListings){%>
        <a href="/listing/<%=info._id%>" class="listing-link">
        <div class="card col" style="width: 20rem;">
            <img src="<%= info.image.url %>" class="card-img-top" alt="listing image" style="height:20rem;"/>
            <div class="card-img-overlay"></div>
            <div class="card-body">
                <p class="card-text">
                    <b><%=info.title%></b>
                    <br>&#8377; <%= info.price.toLocaleString("en-IN") %> per night
                </p>
            </div>
        </div>
        </a>
        <%}%>
    </div>
</body>
