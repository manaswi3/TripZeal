<% layout("/layouts/boilerplate") -%>

<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/listings/new.css"/>

<div class="new-listing-page">
  <div class="page-heading">
    <h2>
      Add new location
      <svg width="32" viewBox="0 0 36 22" fill="none" style="vertical-align:middle;">
        <path d="M2 11 Q7 4 13 11 Q19 18 25 11 Q31 4 34 11" stroke="#FFB800" stroke-width="2.5" stroke-linecap="round" fill="none"/>
      </svg>
    </h2>
    <p>Share your space with travelers and start hosting today.</p>
  </div>

  <div class="new-listing-layout">

    <!-- LEFT sidebar -->
    <aside class="sidebar-steps">
      <div class="step-item active">
        <div class="step-num">1</div>
        <span class="step-label">Basics</span>
      </div>
      <div class="step-item">
        <div class="step-num">2</div>
        <span class="step-label">Details</span>
      </div>
      <div class="step-item">
        <div class="step-num">3</div>
        <span class="step-label">Location</span>
      </div>
      <div class="step-item">
        <div class="step-num">4</div>
        <span class="step-label">Photos</span>
      </div>
    </aside>

    <!-- CENTER form -->
    <div class="form-col">
      <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">

        <!-- Basics -->
        <div class="form-section-title">
          <i class="fa-solid fa-pen-nib"></i> Basic Information
        </div>

        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input placeholder="Add a catchy title" name="listing[title]" type="text" class="form-control" required>
          <div class="valid-feedback">Title looks good!</div>
          <div class="invalid-feedback">Please add a title.</div>
        </div>

        <div class="mb-4">
          <label for="description" class="form-label">Description</label>
          <textarea name="listing[description]" class="form-control" rows="4" placeholder="Describe your place… what makes it special?" required></textarea>
          <div class="invalid-feedback">Please enter a short description.</div>
        </div>

        <!-- Pricing -->
        <div class="form-section-title mt-2">
          <i class="fa-solid fa-indian-rupee-sign"></i> Pricing &amp; Details
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price per night</label>
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <input placeholder="Enter price" name="listing[price]" type="number" min="0" class="form-control" required>
            </div>
            <div class="invalid-feedback">Price should be valid.</div>
          </div>
          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input placeholder="Enter country" name="listing[country]" type="text" class="form-control" required>
            <div class="invalid-feedback">Country name should be valid.</div>
          </div>
        </div>

        <!-- Location -->
        <div class="form-section-title mt-2">
          <i class="fa-solid fa-location-dot"></i> Location
        </div>

        <div class="mb-4">
          <label for="location" class="form-label">Exact Location</label>
          <input placeholder="City, neighbourhood, or address" name="listing[location]" type="text" class="form-control" required>
          <div class="invalid-feedback">Location should be valid.</div>
        </div>

        <!-- Photos -->
        <div class="form-section-title mt-2">
          <i class="fa-solid fa-images"></i> Upload Photo
        </div>

        <div class="mb-4">
          <label class="form-label">Main Image</label>
          <div class="upload-zone" id="uploadZone">
            <input name="listing[image]" type="file" id="imgInput" accept="image/*" required>
            <div class="upload-icon"><i class="fa-regular fa-image"></i></div>
            <p><b>Click to upload</b></p>
            <p style="font-size:0.7rem;color:#ccc;margin-top:0.2rem;">PNG, JPG up to 10MB</p>
          </div>
          <div id="uploadPreview" style="display:none;margin-top:0.8rem;border-radius:10px;overflow:hidden;">
            <img id="previewImg" src="" alt="Preview" style="width:100%;max-height:200px;object-fit:cover;">
          </div>
        </div>

        <button type="submit" class="btn-add">
          <i class="fa-solid fa-paper-plane"></i> Add Listing
        </button>

      </form>
    </div>

    <!-- RIGHT doodle col -->
    <aside class="doodle-col">
      <svg width="170" height="230" viewBox="0 0 170 230" fill="none" style="opacity:0.6;">
        <line x1="85" y1="40" x2="85" y2="210" stroke="#1a1a1a" stroke-width="2.2"/>
        <rect x="58" y="44" width="72" height="22" rx="3" fill="#FFB800" stroke="#1a1a1a" stroke-width="1.5"/>
        <text x="94" y="59" text-anchor="middle" font-family="Poppins,sans-serif" font-size="9" font-weight="600" fill="#1a1a1a">BEACHES</text>
        <rect x="48" y="72" width="72" height="22" rx="3" fill="#fff" stroke="#1a1a1a" stroke-width="1.5"/>
        <text x="84" y="87" text-anchor="middle" font-family="Poppins,sans-serif" font-size="9" font-weight="600" fill="#1a1a1a">MOUNTAINS</text>
        <rect x="55" y="100" width="72" height="22" rx="3" fill="#FFB800" stroke="#1a1a1a" stroke-width="1.5"/>
        <text x="91" y="115" text-anchor="middle" font-family="Poppins,sans-serif" font-size="9" font-weight="600" fill="#1a1a1a">CASTLES</text>
        <rect x="50" y="128" width="72" height="22" rx="3" fill="#fff" stroke="#1a1a1a" stroke-width="1.5"/>
        <text x="86" y="143" text-anchor="middle" font-family="Poppins,sans-serif" font-size="9" font-weight="600" fill="#1a1a1a">VILLAS</text>
        <line x1="60" y1="210" x2="115" y2="210" stroke="#1a1a1a" stroke-width="1.5" stroke-dasharray="4,3"/>
      </svg>
    </aside>

  </div>
</div>

<script>
  // Bootstrap validation
  (() => {
    'use strict';
    document.querySelectorAll('.needs-validation').forEach(form => {
      form.addEventListener('submit', e => {
        if (!form.checkValidity()) { e.preventDefault(); e.stopPropagation(); }
        form.classList.add('was-validated');
      }, false);
    });
  })();

  // Image preview
  document.getElementById('imgInput').addEventListener('change', function () {
    const file = this.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      document.getElementById('previewImg').src = e.target.result;
      document.getElementById('uploadPreview').style.display = 'block';
    };
    reader.readAsDataURL(file);
  });

  // Sidebar highlight on scroll
  const titles  = document.querySelectorAll('.form-section-title');
  const sideItems = document.querySelectorAll('.step-item');
  window.addEventListener('scroll', () => {
    let current = 0;
    titles.forEach((t, i) => {
      if (window.scrollY + 180 >= t.offsetTop) current = i;
    });
    sideItems.forEach((s, i) => s.classList.toggle('active', i === current));
  });
</script>
