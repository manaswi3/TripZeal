<% layout("/layouts/boilerplate") -%>

<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  body { background: #FDFAF3; font-family: 'Poppins', sans-serif; }

  .new-listing-page {
    min-height: 100vh;
    padding: 2.5rem 1.5rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .page-heading h2 {
    font-family: 'Caveat', cursive;
    font-size: 2.4rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.2rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .page-heading p { font-size: 0.88rem; color: #777; margin: 0 0 2rem; }

  .new-listing-layout {
    display: grid;
    grid-template-columns: 180px 1fr 220px;
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .new-listing-layout { grid-template-columns: 1fr; }
    .doodle-col { display: none; }
    .sidebar-steps { flex-direction: row; flex-wrap: wrap; position: static; }
  }

  .sidebar-steps {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    position: sticky;
    top: 100px;
  }
  .step-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    border-radius: 12px;
    color: #999;
  }
  .step-item.active { background: #FFB800; color: #1a1a1a; }
  .step-num {
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 2px solid currentColor;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.72rem; font-weight: 700; flex-shrink: 0;
  }
  .step-item.active .step-num { background: #1a1a1a; border-color: #1a1a1a; color: #FFB800; }
  .step-label { font-size: 0.83rem; font-weight: 500; }

  .form-col {
    background: #fff;
    border-radius: 20px;
    padding: 2rem 2rem 2.5rem;
    box-shadow: 0 4px 24px rgba(0,0,0,0.07);
  }
  .form-section-title {
    font-size: 1.05rem; font-weight: 700; color: #1a1a1a;
    margin-bottom: 1.4rem; padding-bottom: 0.6rem;
    border-bottom: 2px solid #f0ebe0;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .form-section-title i { color: #FFB800; }

  .form-label { font-size: 0.82rem; font-weight: 600; color: #444; margin-bottom: 0.4rem; }

  .form-control {
    border: 1.5px solid #e5e0d8 !important;
    border-radius: 10px !important;
    font-family: 'Poppins', sans-serif !important;
    font-size: 0.88rem !important;
    color: #1a1a1a !important;
    background: #FDFAF3 !important;
    padding: 0.65rem 1rem !important;
  }
  .form-control:focus {
    border-color: #FFB800 !important;
    box-shadow: 0 0 0 3px rgba(255,184,0,0.15) !important;
    background: #fff !important;
  }
  .form-control::placeholder { color: #bbb !important; }

  .input-group-text {
    background: #f5f0e8 !important;
    border: 1.5px solid #e5e0d8 !important;
    border-right: none !important;
    border-radius: 10px 0 0 10px !important;
    font-weight: 600; color: #888;
  }
  .input-group .form-control {
    border-left: none !important;
    border-radius: 0 10px 10px 0 !important;
  }
  .input-group:focus-within .input-group-text { border-color: #FFB800 !important; }

  .upload-zone {
    border: 2px dashed #d0c8b8;
    border-radius: 14px;
    padding: 1.8rem 1rem;
    text-align: center;
    background: #FDFAF3;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    position: relative;
  }
  .upload-zone:hover { border-color: #FFB800; background: rgba(255,184,0,0.05); }
  .upload-zone input[type="file"] {
    position: absolute; inset: 0; opacity: 0;
    cursor: pointer; width: 100%; height: 100%;
  }
  .upload-zone .upload-icon { font-size: 2rem; color: #ccc; margin-bottom: 0.5rem; }
  .upload-zone p { font-size: 0.8rem; color: #aaa; margin: 0; }
  .upload-zone p b { color: #FFB800; }

  .btn-add {
    background: #FFB800;
    border: none;
    color: #1a1a1a;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.65rem 2.2rem;
    border-radius: 50px;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    box-shadow: 0 4px 14px rgba(255,184,0,0.3);
    display: inline-flex; align-items: center; gap: 0.5rem;
  }
  .btn-add:hover { background: #e6a500; transform: translateY(-1px); }

  .doodle-col {
    display: flex; flex-direction: column;
    align-items: center; gap: 1rem;
    position: sticky; top: 100px;
  }
  .doodle-upload-box {
    border: 2px dashed #ccc; border-radius: 16px;
    padding: 1.5rem 1rem; text-align: center;
    background: #fff; width: 100%;
  }
  .doodle-upload-box p { font-size: 0.74rem; color: #aaa; margin: 0.4rem 0 0; }
  .doodle-upload-box .sub { font-size: 0.66rem; color: #ccc; }
</style>

<div class="new-listing-page">

  <div class="page-heading">
    <h2>
      Add new location
      <svg width="32" viewBox="0 0 36 22" fill="none" style="vertical-align:middle;">
        <path d="M2 11 Q7 4 13 11 Q19 18 25 11 Q31 4 34 11" stroke="#FFB800" stroke-width="2.5" stroke-linecap="round" fill="none"/>
      </svg>
    </h2>
    <p>Share your space with travelers and start hosting today.</p>
  </div>

  <div class="new-listing-layout">

    <!-- LEFT sidebar -->
    <aside class="sidebar-steps">
      <div class="step-item active">
        <div class="step-num">1</div>
        <span class="step-label">Basics</span>
      </div>
      <div class="step-item">
        <div class="step-num">2</div>
        <span class="step-label">Details</span>
      </div>
      <div class="step-item">
        <div class="step-num">3</div>
        <span class="step-label">Location</span>
      </div>
      <div class="step-item">
        <div class="step-num">4</div>
        <span class="step-label">Photos</span>
      </div>
    </aside>

    <!-- CENTER form -->
    <div class="form-col">
      <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">

        <!-- Basics -->
        <div class="form-section-title">
          <i class="fa-solid fa-pen-nib"></i> Basic Information
        </div>

        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input placeholder="Add a catchy title" name="listing[title]" type="text" class="form-control" required>
          <div class="valid-feedback">Title looks good!</div>
          <div class="invalid-feedback">Please add a title.</div>
        </div>

        <div class="mb-4">
          <label for="description" class="form-label">Description</label>
          <textarea name="listing[description]" class="form-control" rows="4" placeholder="Describe your place… what makes it special?" required></textarea>
          <div class="invalid-feedback">Please enter a short description.</div>
        </div>

        <!-- Pricing -->
        <div class="form-section-title mt-2">
          <i class="fa-solid fa-indian-rupee-sign"></i> Pricing &amp; Details
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price per night</label>
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <input placeholder="Enter price" name="listing[price]" type="number" min="0" class="form-control" required>
            </div>
            <div class="invalid-feedback">Price should be valid.</div>
          </div>
          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input placeholder="Enter country" name="listing[country]" type="text" class="form-control" required>
            <div class="invalid-feedback">Country name should be valid.</div>
          </div>
        </div>

        <!-- Location -->
        <div class="form-section-title mt-2">
          <i class="fa-solid fa-location-dot"></i> Location
        </div>

        <div class="mb-4">
          <label for="location" class="form-label">Exact Location</label>
          <input placeholder="City, neighbourhood, or address" name="listing[location]" type="text" class="form-control" required>
          <div class="invalid-feedback">Location should be valid.</div>
        </div>

        <!-- Photos -->
        <div class="form-section-title mt-2">
          <i class="fa-solid fa-images"></i> Upload Photo
        </div>

        <div class="mb-4">
          <label class="form-label">Main Image</label>
          <div class="upload-zone" id="uploadZone">
            <input name="listing[image]" type="file" id="imgInput" accept="image/*" required>
            <div class="upload-icon"><i class="fa-regular fa-image"></i></div>
            <p><b>Click to upload</b></p>
            <p style="font-size:0.7rem;color:#ccc;margin-top:0.2rem;">PNG, JPG up to 10MB</p>
          </div>
          <div id="uploadPreview" style="display:none;margin-top:0.8rem;border-radius:10px;overflow:hidden;">
            <img id="previewImg" src="" alt="Preview" style="width:100%;max-height:200px;object-fit:cover;">
          </div>
        </div>

        <button type="submit" class="btn-add">
          <i class="fa-solid fa-paper-plane"></i> Add Listing
        </button>

      </form>
    </div>

    <!-- RIGHT doodle col -->
    <aside class="doodle-col">
      <svg width="170" height="230" viewBox="0 0 170 230" fill="none" style="opacity:0.6;">
        <line x1="85" y1="40" x2="85" y2="210" stroke="#1a1a1a" stroke-width="2.2"/>
        <rect x="58" y="44" width="72" height="22" rx="3" fill="#FFB800" stroke="#1a1a1a" stroke-width="1.5"/>
        <text x="94" y="59" text-anchor="middle" font-family="Poppins,sans-serif" font-size="9" font-weight="600" fill="#1a1a1a">BEACHES</text>
        <rect x="48" y="72" width="72" height="22" rx="3" fill="#fff" stroke="#1a1a1a" stroke-width="1.5"/>
        <text x="84" y="87" text-anchor="middle" font-family="Poppins,sans-serif" font-size="9" font-weight="600" fill="#1a1a1a">MOUNTAINS</text>
        <rect x="55" y="100" width="72" height="22" rx="3" fill="#FFB800" stroke="#1a1a1a" stroke-width="1.5"/>
        <text x="91" y="115" text-anchor="middle" font-family="Poppins,sans-serif" font-size="9" font-weight="600" fill="#1a1a1a">CASTLES</text>
        <rect x="50" y="128" width="72" height="22" rx="3" fill="#fff" stroke="#1a1a1a" stroke-width="1.5"/>
        <text x="86" y="143" text-anchor="middle" font-family="Poppins,sans-serif" font-size="9" font-weight="600" fill="#1a1a1a">VILLAS</text>
        <line x1="60" y1="210" x2="115" y2="210" stroke="#1a1a1a" stroke-width="1.5" stroke-dasharray="4,3"/>
        <rect x="60" y="175" width="22" height="26" rx="4" fill="none" stroke="#1a1a1a" stroke-width="1.5"/>
        <path d="M66 175 Q71 168 76 175" fill="none" stroke="#1a1a1a" stroke-width="1.5"/>
        <line x1="60" y1="185" x2="82" y2="185" stroke="#1a1a1a" stroke-width="1"/>
        <path d="M120,30 L105,55 L115,48 Z" stroke="#1a1a1a" stroke-width="1.3" fill="none" stroke-linejoin="round"/>
        <path d="M115,48 L113,60 L120,30 Z" stroke="#1a1a1a" stroke-width="1.3" fill="none" stroke-linejoin="round"/>
        <path d="M105,55 Q98,70 93,85" stroke="#888" stroke-width="1" stroke-dasharray="3,4" fill="none"/>
        <path d="M128,80 Q124,80 124,76 Q124,72 128,72 Q128,67 133,67 Q137,67 138,71 Q141,70 143,73 Q146,73 146,76 Q146,80 143,80 Z" stroke="#bbb" stroke-width="1.2" fill="none"/>
      </svg>
    </aside>

  </div>
</div>

<script>
  // Bootstrap validation
  (() => {
    'use strict';
    document.querySelectorAll('.needs-validation').forEach(form => {
      form.addEventListener('submit', e => {
        if (!form.checkValidity()) { e.preventDefault(); e.stopPropagation(); }
        form.classList.add('was-validated');
      }, false);
    });
  })();

  // Image preview
  document.getElementById('imgInput').addEventListener('change', function () {
    const file = this.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      document.getElementById('previewImg').src = e.target.result;
      document.getElementById('uploadPreview').style.display = 'block';
    };
    reader.readAsDataURL(file);
  });

  // Sidebar highlight on scroll
  const titles  = document.querySelectorAll('.form-section-title');
  const sideItems = document.querySelectorAll('.step-item');
  window.addEventListener('scroll', () => {
    let current = 0;
    titles.forEach((t, i) => {
      if (window.scrollY + 180 >= t.offsetTop) current = i;
    });
    sideItems.forEach((s, i) => s.classList.toggle('active', i === current));
  });
</script>
