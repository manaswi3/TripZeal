<% layout("/layouts/boilerplate") -%>
<div class="row mt-3">
    <div class="col-8 offset-3">
    <h3><%=data.title%></h3>
    </div>
    <div class="card col-6 offset-3 show-card">
        <img src="<%=data.image.url%>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
            <p class="card-text">
                
                <%=data.description%> <br>
                &#8377; <%= data.price.toLocaleString("en-IN") %><br>
                <%=data.location%><br>
                <%=data.country%><br>
            </p>
  </div>
    </div>

    <!-- <ul>
        <li><%=data.title%></li>
        <li><%=data.description%></li>
        <li> &#8377; <%= data.price.toLocaleString("en-IN") %></li>
        <li><%=data.location%></li>
        <li><%=data.country%></li>
    </ul>
    <br> -->
    <div class="btns">
    <a href="/listing/<%=data._id%>/edit" class="btn btn-dark add-btn col-1 offset-3">Edit</a>
    
    <form method="post" action="/listing/<%=data._id%>?_method=DELETE">
        <button class="btn btn-dark offset-7">Delete</button>
    </form>
 </div>

 <div class="col-8 offset-3">
    <br><br>
    <h4>Leave a Review</h4>
    <form>
        <div>
            <label for="rating">Rating</label>
            <input type="range" min="1" max="5" id="rating" name="review[rating]">
        </div>
        <div>
            <label for="comment">Comments</label>
            <br>
            <textarea name="review[comment]" id="comment" cols="35" rows="4"></textarea>
        </div>
        <button>Submit</button>
    </form>
 </div>

</div>

