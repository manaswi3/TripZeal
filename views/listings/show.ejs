<% layout("/layouts/boilerplate") -%>

<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<script>
    const cc = JSON.parse('<%- JSON.stringify(data.coordinates) %>');
</script>
<link rel="stylesheet" href="/css/listings/show.css"/>

<div class="show-page">

  <!-- Back link -->
  <a href="/listings" class="back-link">
    <i class="fa-solid fa-arrow-left"></i> Back to listings
  </a>

  <!-- Title + location -->
  <h1 class="listing-title"><%= data.title %></h1>
  <div class="listing-meta">
    <i class="fa-solid fa-location-dot"></i>
    <%= data.location %>, <%= data.country %>
  </div>

  <!-- Two-column layout -->
  <div class="show-layout">

    <!-- ── LEFT col ── -->
    <div>

      <!-- Hero image -->
      <div class="hero-img-wrap">
        <img src="<%= data.image.url %>" alt="<%= data.title %>">
        <button class="save-btn" onclick="this.querySelector('i').classList.toggle('fa-solid'); this.querySelector('i').classList.toggle('fa-regular'); this.style.color=this.querySelector('i').classList.contains('fa-solid')?'#e74c3c':''">
          <i class="fa-regular fa-heart"></i>
        </button>
      </div>

      <!-- Owner + description -->
      <div class="section-title">
        <i class="fa-solid fa-circle-info"></i> About this place
      </div>

      <div class="owner-row">
        <div class="owner-avatar"><%= data.owner.username.charAt(0) %></div>
        <div>
          <div class="owner-name">Hosted by <%= data.owner.username %></div>
          <div class="owner-label">Superhost &nbsp;·&nbsp; TripZeal Host</div>
        </div>
      </div>

      <p class="description-text"><%= data.description %></p>

      <!-- Detail chips -->
      <div class="detail-chips">
        <div class="chip"><i class="fa-solid fa-location-dot"></i> <%= data.location %></div>
        <div class="chip"><i class="fa-solid fa-flag"></i> <%= data.country %></div>
        <div class="chip"><i class="fa-solid fa-indian-rupee-sign"></i> <%= data.price.toLocaleString("en-IN") %> / night</div>
      </div>

      <!-- Edit / Delete (owner only) -->
      <% if(currUser && data.owner._id.equals(currUser._id)){ %>
      <div class="owner-actions">
        <a href="/listings/<%= data._id %>/edit" class="btn-edit">
          <i class="fa-solid fa-pen"></i> Edit listing
        </a>
        <form method="post" action="/listings/<%= data._id %>?_method=DELETE" style="margin:0;">
          <button type="submit" class="btn-delete">
            <i class="fa-solid fa-trash"></i> Delete
          </button>
        </form>
      </div>
      <% } %>

      <div class="section-divider"></div>

      <!-- Map -->
      <div class="map-section">
        <div class="section-title">
          <i class="fa-solid fa-map-location-dot"></i> Where you'll be
        </div>
        <div id="map"></div>
      </div>

      <div class="section-divider"></div>

      <!-- Reviews -->
      <div class="reviews-section">

        <% if(currUser) { %>
        <div class="section-title">
          <i class="fa-solid fa-star"></i> Leave a Review
        </div>
        <div class="review-form-card">
          <form action="/listings/<%= data._id %>/reviews" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
              <label class="form-label">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-3">
              <label for="comment" class="form-label">Your comment</label>
              <textarea name="review[comment]" id="comment" rows="3" class="form-control" placeholder="Share your experience…" required></textarea>
              <div class="invalid-feedback">Please add a comment.</div>
            </div>
            <button type="submit" class="btn-review-submit">
              <i class="fa-solid fa-paper-plane"></i> &nbsp;Submit Review
            </button>
          </form>
        </div>
        <% } %>

        <% if(data.reviews.length > 0) { %>
        <div class="section-title mt-3">
          <i class="fa-solid fa-comments"></i> All Reviews
        </div>
        <div class="review-grid">
          <% for(let rev of data.reviews) { %>
          <div class="review-card">
            <div class="review-card-author">@<%= rev.author.username %></div>
            <p class="starability-result" data-rating="<%= rev.rating %>"></p>
            <p class="review-card-comment"><%= rev.comment %></p>
            <% if(currUser && rev.author._id.equals(currUser._id)) { %>
            <form action="/listings/<%= data._id %>/reviews/<%= rev._id %>?_method=DELETE" method="POST" style="margin:0;">
              <button type="submit" class="btn-del-review">
                <i class="fa-solid fa-trash"></i> Delete
              </button>
            </form>
            <% } %>
          </div>
          <% } %>
        </div>
        <% } %>

      </div><!-- /reviews -->

    </div><!-- /left col -->

    <!-- ── RIGHT: Booking card ── -->
    <aside>
      <div class="booking-card">

        <div class="booking-price">
          &#8377; <%= data.price.toLocaleString("en-IN") %>
          <span>/ night</span>
        </div>

        <div class="booking-rating">
          <span style="font-weight:400;color:#aaa;">&nbsp;TripZeal Verified</span>
        </div>

        <!-- Check-in / Check-out -->
        <div class="date-row">
          <div class="date-cell">
            <label>Check in</label>
            <input type="date" placeholder="Add date">
          </div>
          <div class="date-cell">
            <label>Check out</label>
            <input type="date" placeholder="Add date">
          </div>
        </div>

        <!-- Guests -->
        <div class="guests-select">
          <label>Guests</label>
          <select>
            <option>1 guest</option>
            <option selected>2 guests</option>
            <option>3 guests</option>
            <option>4 guests</option>
            <option>5+ guests</option>
          </select>
        </div>

        <button class="btn-book">Book Now</button>

        <button class="btn-wishlist" onclick="this.innerHTML=this.innerHTML.includes('fa-regular')?'<i class=\'fa-solid fa-heart\' style=\'color:#e74c3c\'></i>&nbsp; Saved!':'<i class=\'fa-regular fa-heart\'></i>&nbsp; Save to wishlist'">
          <i class="fa-regular fa-heart"></i>&nbsp; Save to wishlist
        </button>

        <div class="booking-divider"></div>

        <div class="hosted-row">
          <div class="hosted-avatar"><%= data.owner.username.charAt(0) %></div>
          <div class="hosted-info">
            <b><%= data.owner.username %></b>
            Hosted by · Superhost
          </div>
        </div>

      </div>
    </aside>

  </div><!-- /show-layout -->
</div>

<script>
  // Bootstrap validation
  (() => {
    'use strict';
    document.querySelectorAll('.needs-validation').forEach(form => {
      form.addEventListener('submit', e => {
        if (!form.checkValidity()) { e.preventDefault(); e.stopPropagation(); }
        form.classList.add('was-validated');
      }, false);
    });
  })();
</script>

<script src="/js/map.js" type="module"></script>
