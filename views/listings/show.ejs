<% layout("/layouts/boilerplate") -%>
<div class="row mt-3">
    <div class="col-8 offset-3">
    <h3><%=data.title%></h3>
    </div>
    <div class="card col-6 offset-3 show-card card-listing">
        <img src="<%=data.image.url%>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
            <p class="card-text">
                
                <%=data.description%> <br>
                &#8377; <%= data.price.toLocaleString("en-IN") %><br>
                <%=data.location%><br>
                <%=data.country%><br>
            </p>
  </div>
    </div>

    <!-- <ul>
        <li><%=data.title%></li>
        <li><%=data.description%></li>
        <li> &#8377; <%= data.price.toLocaleString("en-IN") %></li>
        <li><%=data.location%></li>
        <li><%=data.country%></li>
    </ul>
    <br> -->
    <div class="btns">
    <a href="/listing/<%=data._id%>/edit" class="btn btn-dark add-btn col-1 offset-3">Edit</a>
    
    <form method="post" action="/listing/<%=data._id%>?_method=DELETE">
        <button class="btn btn-dark offset-7">Delete</button>
    </form>
 </div>


 <!-- REVIEW SECTION -->

 <div class="col-8 offset-3 mb-3">
    <br><hr/>
    <h4>Leave a Review</h4>
    <form action="/listings/<%=data._id%>/reviews" method="POST" class="needs-validation" novalidate>
        <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
            <input class="form-range" type="range" min="1" max="5" id="rating" name="review[rating]">
        </div>
        <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" id="comment" cols="35" rows="4" class="form-control" required></textarea>
            <div class="invalid-feedback">Please add a comment</div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
    </form>

    <hr/>
    <p><b>All Reviews</b></p>
    <div class="row">
    <%for(rev of data.reviews) {%>
        <div class="card col-5 ms-3 mb-3">
            <div class="card-body">
                <h5 class="card-title">Tony Stark</h5>
                <p class="card-text"><%= rev.comment %></p>
                <p class="card-text"><%= rev.rating %> stars</p>
            </div>
        </div>
    <%}%>
    </div>
    
 </div>

 

</div>

