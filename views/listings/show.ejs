<% layout("/layouts/boilerplate") -%>
<div class="row mt-3">
    <div class="col-8 offset-3">
    <h3>Listing Details</h3>
    </div>
    <div class="card col-6 offset-3 show-card">
        <img src="<%=data.image.url%>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
            <p class="card-text">
                <b><%=data.title%></b><br>
                <%=data.description%> <br>
                &#8377; <%= data.price.toLocaleString("en-IN") %><br>
                <%=data.location%><br>
                <%=data.country%><br>
            </p>
  </div>
    </div>

    <!-- <ul>
        <li><%=data.title%></li>
        <li><%=data.description%></li>
        <li> &#8377; <%= data.price.toLocaleString("en-IN") %></li>
        <li><%=data.location%></li>
        <li><%=data.country%></li>
    </ul>
    <br> -->
    <div class="btns">
    <a href="/listing/<%=data._id%>/edit" class="btn btn-dark add-btn col-1 offset-3">Edit</a>
    
    <form method="post" action="/listing/<%=data._id%>?_method=DELETE">
        <button class="btn btn-dark offset-7">Delete</button>
    </form>
 </div>
</div>

