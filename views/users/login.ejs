<% layout("/layouts/boilerplate") -%>

<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  body { background: #FDFAF3; font-family: 'Poppins', sans-serif; margin: 0; }

  /* ── Full page wrapper ── */
  .login-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding: 2.5rem 1rem 0;
  }

  /* ── Floating doodles ── */
  .doodle { position: absolute; pointer-events: none; }

  /* ── Heading ── */
  .login-heading { text-align: center; margin-bottom: 1.6rem; z-index: 2; }
  .login-heading h1 {
    font-family: 'Caveat', cursive;
    font-size: 2.6rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.3rem;
    display: flex; align-items: center; justify-content: center; gap: 0.4rem;
  }
  .login-heading p { font-size: 0.88rem; color: #888; margin: 0; }

  /* ── Card (tape-pinned look) ── */
  .login-card {
    background: #fff;
    border-radius: 20px;
    padding: 2rem 2.2rem 2.2rem;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.09);
    position: relative;
    z-index: 2;
  }
  /* ── Form labels & inputs ── */
  .form-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #444;
    margin-bottom: 0.35rem;
    display: block;
  }
  .input-wrap {
    display: flex;
    align-items: center;
    border: 1.5px solid #e5e0d8;
    border-radius: 10px;
    background: #FDFAF3;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
    margin-bottom: 1.1rem;
  }
  .input-wrap:focus-within {
    border-color: #FFB800;
    box-shadow: 0 0 0 3px rgba(255,184,0,0.15);
    background: #fff;
  }
  .input-wrap i {
    padding: 0 0.75rem;
    color: #ccc;
    margin-right: 8px;
    font-size: 0.85rem;
    flex-shrink: 0;
  }
  .input-wrap input {
    flex: 1;
    border: none;
    outline: none;
    padding: 0.68rem 0.5rem 0.68rem 0;
    font-family: 'Poppins', sans-serif;
    font-size: 0.86rem;
    color: #1a1a1a;
    background: transparent;
  }
  .input-wrap input::placeholder { color: #bbb; }
  .input-wrap .toggle-pw {
    padding: 0 0.75rem;
    background: none;
    border: none;
    color: #bbb;
    cursor: pointer;
    font-size: 0.85rem;
    flex-shrink: 0;
    transition: color 0.2s;
  }
  .input-wrap .toggle-pw:hover { color: #FFB800; }

  /* Remember + Forgot row */
  .remember-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.3rem;
  }
  .remember-row label {
    display: flex; align-items: center; gap: 0.4rem;
    font-size: 0.78rem; color: #555; cursor: pointer;
  }
  .remember-row input[type="checkbox"] { accent-color: #FFB800; width: 14px; height: 14px; }
  .forgot-link { font-size: 0.78rem; font-weight: 600; color: #FFB800; text-decoration: none; }
  .forgot-link:hover { text-decoration: underline; }

  /* Submit button */
  .btn-login {
    width: 100%;
    background: #FFB800;
    border: none;
    color: #1a1a1a;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.75rem;
    border-radius: 12px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 0.6rem;
    box-shadow: 0 4px 14px rgba(255,184,0,0.35);
    transition: background 0.2s, transform 0.15s;
    margin-bottom: 1rem;
  }
  .btn-login:hover { background: #e6a500; transform: translateY(-1px); }

  /* OR divider */
  .or-divider {
    display: flex; align-items: center; gap: 0.7rem;
    margin-bottom: 0.9rem;
    font-size: 0.75rem; color: #bbb;
  }
  .or-divider::before, .or-divider::after {
    content: ''; flex: 1; height: 1px; background: #e5e0d8;
  }

  /* Google button */
  .btn-google {
    width: 100%;
    background: #fff;
    border: 1.5px solid #e5e0d8;
    color: #444;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.68rem;
    border-radius: 12px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 0.6rem;
    transition: border-color 0.2s, box-shadow 0.2s;
    margin-bottom: 1.2rem;
  }
  .btn-google:hover { border-color: #aaa; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }

  /* Sign up link */
  .signup-text {
    text-align: center;
    font-size: 0.8rem;
    color: #888;
  }
  .signup-text a { color: #FFB800; font-weight: 600; text-decoration: none; }
  .signup-text a:hover { text-decoration: underline; }

  /* Passport stamp doodle */
  .passport-stamp {
    position: absolute;
    top: 4rem;
    right: 8%;
    opacity: 0.18;
    z-index: 1;
  }
</style>

<div class="login-page">

  <!-- Floating doodles -->
  <!-- Paper plane top-left -->
  <svg class="doodle" style="top:5%;left:5%;width:52px;opacity:0.4;" viewBox="0 0 60 40" fill="none">
    <path d="M2 38 L58 5 L32 35 Z" stroke="#555" stroke-width="1.5" fill="none"/>
    <path d="M32 35 L28 22 L58 5 Z" stroke="#555" stroke-width="1.5" fill="none"/>
    <path d="M2 38 Q-4 20 8 10" stroke="#888" stroke-width="1" stroke-dasharray="3,4" fill="none"/>
  </svg>
  <!-- Cloud top-right -->
  <svg class="doodle" style="top:4%;right:6%;width:72px;opacity:0.35;" viewBox="0 0 80 40" fill="none">
    <path d="M15 30 Q10 30 10 24 Q10 18 16 18 Q16 10 24 10 Q30 10 32 16 Q36 14 40 18 Q46 18 46 24 Q46 30 40 30 Z" stroke="#aaa" stroke-width="1.5" fill="none"/>
  </svg>
  <!-- Small cloud -->
  <svg class="doodle" style="top:12%;right:14%;width:44px;opacity:0.3;" viewBox="0 0 80 40" fill="none">
    <path d="M15 30 Q10 30 10 24 Q10 18 16 18 Q16 10 24 10 Q30 10 32 16 Q36 14 40 18 Q46 18 46 24 Q46 30 40 30 Z" stroke="#bbb" stroke-width="1.5" fill="none"/>
  </svg>
  <!-- Birds top-left area -->
  <svg class="doodle" style="top:18%;left:9%;width:38px;opacity:0.3;" viewBox="0 0 50 20" fill="none">
    <path d="M2 10 Q8 4 14 10" stroke="#777" stroke-width="1.4" fill="none" stroke-linecap="round"/>
    <path d="M18 7 Q24 1 30 7" stroke="#777" stroke-width="1.4" fill="none" stroke-linecap="round"/>
    <path d="M34 11 Q40 5 46 11" stroke="#888" stroke-width="1.2" fill="none" stroke-linecap="round"/>
  </svg>
  <!-- Star top-left -->
  <svg class="doodle" style="top:6%;left:18%;width:18px;opacity:0.5;" viewBox="0 0 24 24" fill="none">
    <path d="M12 2l2.09 6.26L21 9.27l-5 4.73 1.18 6.9L12 17.77l-5.18 3.13L8 14l-5-4.73 6.91-1.01L12 2z" fill="#FFB800"/>
  </svg>

  <!-- Passport stamp -->
  <svg class="passport-stamp" width="90" height="90" viewBox="0 0 100 100" fill="none">
    <rect x="5" y="5" width="90" height="90" rx="8" stroke="#888" stroke-width="2" fill="none"/>
    <rect x="12" y="12" width="76" height="76" rx="5" stroke="#888" stroke-width="1" fill="none" stroke-dasharray="4,3"/>
    <text x="50" y="38" text-anchor="middle" font-family="Poppins,sans-serif" font-size="7" font-weight="700" fill="#888" letter-spacing="2">PASSPORT</text>
    <text x="50" y="52" text-anchor="middle" font-family="Poppins,sans-serif" font-size="6" fill="#aaa" letter-spacing="1">VERIFIED</text>
    <text x="50" y="66" text-anchor="middle" font-family="Poppins,sans-serif" font-size="5.5" fill="#aaa">TRIPZEAL</text>
    <circle cx="50" cy="50" r="30" stroke="#bbb" stroke-width="0.8" fill="none" opacity="0.5"/>
  </svg>

  <!-- Heading -->
  <div class="login-heading">
    <h1>
      Welcome back!
      <!-- sparkle -->
      <svg width="26" height="26" viewBox="0 0 30 30" fill="none" style="margin-left:2px;">
        <line x1="15" y1="2" x2="15" y2="10" stroke="#FFB800" stroke-width="2.2" stroke-linecap="round"/>
        <line x1="15" y1="20" x2="15" y2="28" stroke="#FFB800" stroke-width="2.2" stroke-linecap="round"/>
        <line x1="2" y1="15" x2="10" y2="15" stroke="#FFB800" stroke-width="2.2" stroke-linecap="round"/>
        <line x1="20" y1="15" x2="28" y2="15" stroke="#FFB800" stroke-width="2.2" stroke-linecap="round"/>
        <line x1="5" y1="5" x2="10" y2="10" stroke="#FFB800" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="20" y1="20" x2="25" y2="25" stroke="#FFB800" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="25" y1="5" x2="20" y2="10" stroke="#FFB800" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="5" y1="25" x2="10" y2="20" stroke="#FFB800" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </h1>
    <p>Log in to continue your journey</p>
  </div>

  <!-- Card -->
  <div class="login-card">

    <form action="/login" method="POST" class="needs-validation" novalidate>

      <!-- Username -->
      <label class="form-label" for="username">Username</label>
      <div class="input-wrap">
        <i class="fa-regular fa-user"></i>
        <input
          type="text"
          id="username"
          name="username"
          placeholder="Enter your username"
          required
          autocomplete="username"
        >
      </div>

      <!-- Password -->
      <label class="form-label" for="password">Password</label>
      <div class="input-wrap">
        <i class="fa-solid fa-lock"></i>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Enter your password"
          required
          autocomplete="current-password"
        >
        <button type="button" class="toggle-pw" onclick="togglePw()" aria-label="Show password">
          <i class="fa-regular fa-eye" id="pwEyeIcon"></i>
        </button>
      </div>

      <!-- Remember me + Forgot -->
      <div class="remember-row">
        <label>
          <input type="checkbox" name="remember"> Remember me
        </label>
        <a href="/forgot-password" class="forgot-link">Forgot password?</a>
      </div>

      <!-- Submit -->
      <button type="submit" class="btn-login">
        Log in <i class="fa-solid fa-arrow-right-to-bracket"></i>
      </button>

    </form>

    <!-- OR / Google -->
    <div class="or-divider">or</div>
    <button class="btn-google" type="button">
      <!-- Google G SVG -->
      <svg width="18" height="18" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
        <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.2l6.7-6.7C35.6 2.4 30.1 0 24 0 14.7 0 6.7 5.4 2.8 13.3l7.8 6C12.5 13 17.8 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.6 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4 6.9-9.9 6.9-17z"/>
        <path fill="#FBBC05" d="M10.6 28.7A14.6 14.6 0 0 1 9.5 24c0-1.6.3-3.2.8-4.7l-7.8-6A24 24 0 0 0 0 24c0 3.9.9 7.5 2.8 10.7l7.8-6z"/>
        <path fill="#34A853" d="M24 48c6.1 0 11.3-2 15-5.5l-7.5-5.8c-2 1.4-4.6 2.2-7.5 2.2-6.2 0-11.5-3.5-13.4-8.7l-7.8 6C6.7 42.6 14.7 48 24 48z"/>
      </svg>
      Continue with Google
    </button>

    <p class="signup-text">
      Don't have an account? <a href="/signup">Sign up</a>
    </p>

  </div><!-- /card -->

</div><!-- /login-page -->

<script>
  // Bootstrap validation
  (() => {
    'use strict';
    document.querySelectorAll('.needs-validation').forEach(form => {
      form.addEventListener('submit', e => {
        if (!form.checkValidity()) { e.preventDefault(); e.stopPropagation(); }
        form.classList.add('was-validated');
      }, false);
    });
  })();

  // Toggle password visibility
  function togglePw() {
    const input = document.getElementById('password');
    const icon  = document.getElementById('pwEyeIcon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
  }
</script>
