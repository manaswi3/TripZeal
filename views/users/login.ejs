    <path d="M75 8 L95 15 L78 24 Z" stroke="#666" stroke-width="1.2" fill="none"/>
  </svg>
  <svg class="doodle" style="top:8%;left:22%;width:20px;opacity:0.5;" viewBox="0 0 24 24" fill="none">
    <path d="M12 2l2.09 6.26L21 9.27l-5 4.73 1.18 6.9L12 17.77l-5.18 3.13L8 14l-5-4.73 6.91-1.01L12 2z" fill="#FFB800"/>
  </svg>
  <svg class="doodle" style="top:32%;left:4%;width:45px;opacity:0.25;" viewBox="0 0 50 40" fill="none">
    <rect x="4" y="12" width="42" height="26" rx="4" stroke="#444" stroke-width="2" fill="none"/>
    <circle cx="25" cy="25" r="8" stroke="#444" stroke-width="2" fill="none"/>
    <path d="M16 12 L19 7 H31 L34 12" stroke="#444" stroke-width="2" fill="none"/>
    <circle cx="39" cy="18" r="2" fill="#444"/>
  </svg>
  <svg class="doodle" style="bottom:15%;left:6%;width:55px;opacity:0.22;" viewBox="0 0 50 50" fill="none">
    <circle cx="25" cy="25" r="20" stroke="#444" stroke-width="1.8" stroke-dasharray="4,3" fill="none"/>
    <polygon points="25,10 29,25 25,40 21,25" fill="#444" opacity="0.6"/>
  </svg>
  <svg class="doodle" style="top:5%;right:8%;width:80px;opacity:0.35;" viewBox="0 0 80 40" fill="none">
    <path d="M15 30 Q10 30 10 24 Q10 18 16 18 Q16 10 24 10 Q30 10 32 16 Q36 14 40 18 Q46 18 46 24 Q46 30 40 30 Z" stroke="#888" stroke-width="1.5" fill="none"/>
  </svg>
  <svg class="doodle" style="top:13%;right:15%;width:50px;opacity:0.3;" viewBox="0 0 80 40" fill="none">
    <path d="M15 30 Q10 30 10 24 Q10 18 16 18 Q16 10 24 10 Q30 10 32 16 Q36 14 40 18 Q46 18 46 24 Q46 30 40 30 Z" stroke="#888" stroke-width="1.5" fill="none"/>
  </svg>
  <svg class="doodle" style="top:28%;right:5%;width:85px;opacity:0.18;" viewBox="0 0 100 100" fill="none">
    <rect x="5" y="5" width="90" height="90" rx="8" stroke="#444" stroke-width="2" fill="none"/>
    <rect x="12" y="12" width="76" height="76" rx="5" stroke="#444" stroke-width="1" fill="none" stroke-dasharray="4,3"/>
    <text x="50" y="38" text-anchor="middle" font-family="Poppins,sans-serif" font-size="7" font-weight="700" fill="#444" letter-spacing="2">PASSPORT</text>
    <text x="50" y="52" text-anchor="middle" font-family="Poppins,sans-serif" font-size="6" fill="#666" letter-spacing="1">VERIFIED</text>
    <text x="50" y="66" text-anchor="middle" font-family="Poppins,sans-serif" font-size="5.5" fill="#666">TRIPZEAL</text>
    <circle cx="50" cy="50" r="30" stroke="#666" stroke-width="0.8" fill="none" opacity="0.5"/>
  </svg>
  <svg class="doodle" style="bottom:10%;right:7%;width:60px;opacity:0.25;" viewBox="0 0 60 60" fill="none">
    <path d="M10 50 Q 30 30, 50 10" stroke="#555" stroke-width="1.5" fill="none"/>
    <path d="M30 35 Q 38 32, 42 24" stroke="#555" stroke-width="1.2" fill="none"/>
    <path d="M20 42 Q 28 39, 32 31" stroke="#555" stroke-width="1.2" fill="none"/>
  </svg>

  <!-- Heading -->
  <div class="login-heading">
    <h1>
      Welcome back!
      <svg width="26" height="26" viewBox="0 0 30 30" fill="none" style="margin-left:2px;">
        <line x1="15" y1="2"  x2="15" y2="10" stroke="#FFB800" stroke-width="2.2" stroke-linecap="round"/>
        <line x1="15" y1="20" x2="15" y2="28" stroke="#FFB800" stroke-width="2.2" stroke-linecap="round"/>
        <line x1="2"  y1="15" x2="10" y2="15" stroke="#FFB800" stroke-width="2.2" stroke-linecap="round"/>
        <line x1="20" y1="15" x2="28" y2="15" stroke="#FFB800" stroke-width="2.2" stroke-linecap="round"/>
        <line x1="5"  y1="5"  x2="10" y2="10" stroke="#FFB800" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="20" y1="20" x2="25" y2="25" stroke="#FFB800" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="25" y1="5"  x2="20" y2="10" stroke="#FFB800" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="5"  y1="25" x2="10" y2="20" stroke="#FFB800" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </h1>
    <p>Log in to continue your journey</p>
  </div>

  <!-- Card -->
  <div class="login-card">
    <form action="/login" method="POST" class="needs-validation" novalidate id="loginForm">

      <!-- Username -->
      <label class="form-label" for="username">Username</label>
      <div class="input-wrap">
        <i class="fa-regular fa-user"></i>
        <input type="text" id="username" name="username" placeholder="Enter your username" required autocomplete="username">
      </div>
      <div class="field-valid">Looks good!</div>
      <div class="field-invalid">Please enter your username.</div>

      <!-- Password -->
      <label class="form-label" for="password">Password</label>
      <div class="input-wrap">
        <i class="fa-solid fa-lock"></i>
        <input type="password" id="password" name="password" placeholder="Enter your password" required autocomplete="current-password">
        <button type="button" class="toggle-pw" onclick="togglePw()">
          <i class="fa-regular fa-eye" id="pwEyeIcon"></i>
        </button>
      </div>
      <div class="field-valid">Password entered!</div>
      <div class="field-invalid">Please enter your password.</div>

      <button type="submit" class="btn-login">
        Log in &nbsp;<i class="fa-solid fa-arrow-right-to-bracket"></i>
      </button>
    </form>

    <div class="or-divider">or</div>
    <p class="signup-text">Don't have an account? <a href="/signup">Sign up</a></p>
  </div>

</div>

<script>
  (() => {
    'use strict';

    const form = document.getElementById('loginForm');

    function validateField(input) {
      const wrap = input.closest('.input-wrap');
      wrap.setAttribute('data-touched', 'true');
      updateFeedback(input);
    }

    function updateFeedback(input) {
      const wrap = input.closest('.input-wrap');
      const fieldGroup = wrap.parentElement;
      const validMsg   = wrap.nextElementSibling;
      const invalidMsg = validMsg?.nextElementSibling;

      if (!validMsg || !invalidMsg) return;

      const touched = wrap.getAttribute('data-touched') === 'true';
      if (!touched) return;

      const isValid = input.validity.valid;
      validMsg.style.display   = isValid ? 'block' : 'none';
      invalidMsg.style.display = isValid ? 'none'  : 'block';

      wrap.classList.toggle('state-valid',   isValid);
      wrap.classList.toggle('state-invalid', !isValid);
    }

    form.querySelectorAll('input[required]').forEach(input => {
      input.addEventListener('blur',  () => validateField(input));
      input.addEventListener('input', () => {

        if (input.closest('.input-wrap').getAttribute('data-touched') === 'true') {
          updateFeedback(input);
        }
      });
    });

    form.addEventListener('submit', e => {
      form.querySelectorAll('input[required]').forEach(input => {
        input.closest('.input-wrap').setAttribute('data-touched', 'true');
        updateFeedback(input);
      });
      if (!form.checkValidity()) {
        e.preventDefault();
        e.stopPropagation();
      }
    });
  })();

  function togglePw() {
    const input = document.getElementById('password');
    const icon  = document.getElementById('pwEyeIcon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
  }
</script>
